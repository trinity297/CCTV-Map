# Copy this file to ".env" in the same folder and edit it.
#   cp .env.example .env
#
# Everything here is optional - the app runs with none of it set.
# ".env" is git-ignored, so keys you put there are never committed.
# IMPORTANT: a line starting with # is switched OFF. To use a setting, delete
# the # from the start of its line - changing only the value leaves it off.
# Do not put quotes around values, and do not add comments after one.


# --- Map background -------------------------------------------------------

# Ordnance Survey Data Hub key, from a project with the OS Maps API added.
# Setting this alone switches the map to OS mapping.
# The key is sent to the browser inside tile URLs (that is how OS raster keys
# work), so restrict it to your host in the Data Hub rather than relying on
# this file to keep it secret.
# CCTV_MAP_OS_API_KEY=your-os-maps-api-key

# Which map background to use. Leave unset for the default.
# Options: carto-voyager (default), carto-positron, carto-dark,
#          os-road, os-light, os-outdoor, osm, none
# CCTV_MAP_TILES=os-light

# Or point at a tile server of your own. This overrides everything above.
# CCTV_MAP_TILE_URL=https://tiles.yourforce.internal/{z}/{x}/{y}.png
# CCTV_MAP_TILE_ATTRIBUTION=Force GIS team
# CCTV_MAP_TILE_MAX_ZOOM=21

# The deepest zoom your provider actually has images for. Run `npm run check`
# and it will measure this and tell you the right number. Setting it too high
# makes the map go blank when you zoom right in.
# CCTV_MAP_TILE_MAX_NATIVE_ZOOM=19
#   ^ delete this # to switch the line on


# --- Access ---------------------------------------------------------------

# Require a shared passcode to open the app.
# CCTV_MAP_PASSCODE=pick-something-long

# Signing key for session cookies. Set this to a long random string if you
# want people to stay signed in across a restart.
# CCTV_MAP_SECRET=a-long-random-string


# --- Server ---------------------------------------------------------------

# Port to listen on.
# PORT=4173

# Which interface to bind. 127.0.0.1 means this machine only.
# Use 0.0.0.0 to share on a network - read the security notes in README.md first.
# HOST=127.0.0.1

# Where the database file lives.
# CCTV_MAP_DB=./data/cctv-map.db
